+test('put handed the record as it was read refuses a write when the record has changed since', () => {
+  const s = createStore();
+  s.put('t', 'x', { n: 1 });
+  const read = s.get('t', 'x');
+  assert.ok(read);
+  assert.equal(read.version, 1);
+  s.put('t', 'x', { n: 2 }, read);
+  assert.throws(() => s.put('t', 'x', { n: 3 }, read), /changed since/);
+  assert.throws(() => s.put('t', 'y', { n: 1 }, read), /changed since/);
+});
