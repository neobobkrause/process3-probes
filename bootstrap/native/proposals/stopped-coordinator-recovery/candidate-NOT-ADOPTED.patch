+def stopped_coordinator_recovery_approved(state):
+    """Proposed policy gate; no adoption writer exists in this candidate.
+
+    A trusted adoption adapter must preserve actual owner approval separately.
+    A policy field is not identity authentication or permission to clear stop.
+    """
+    policy=state.get('native_layout',{}).get('stopped_coordinator_recovery')
+    if not isinstance(policy,dict) or policy.get('enabled') is not True:return False
+    approval=policy.get('owner_approval')
+    if not isinstance(approval,dict):return False
+    return (approval.get('source')=='observed-owner-input'
+            and approval.get('kind')=='decision'
+            and all(isinstance(approval.get(key),str) and approval[key].strip()
+                    for key in ('text','evidence')))
+
+
