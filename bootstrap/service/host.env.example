# Protected /etc/process4/host.env, readable by the trusted service principal only.
# Contains paths and public model selection; no credential values.
P4_POLICY_FILE=/etc/process4/approved-policy.json
P4_POLICY_SHA256=REPLACE_WITH_INDEPENDENTLY_PINNED_SHA256
P4_ISOLATED_EXECUTOR=/srv/process4/host/bootstrap/executor_main.py
P4_PRIVATE_RUNTIME=/var/lib/process4/private
P4_AUTH_SOCKET=/run/process4-auth/owner.sock
P4_MODEL=REPLACE_WITH_SUPPORTED_CHATGPT_PLAN_MODEL

# Optional existing owner-authorized, repository-limited GitHub App installation.
P4_GITHUB_APP_ID=REPLACE_WITH_EXISTING_AUTHORIZED_APP_ID
P4_GITHUB_INSTALLATION_ID=REPLACE_WITH_EXISTING_AUTHORIZED_INSTALLATION_ID
P4_GITHUB_KEY_FILE=/etc/process4/github-app.pem
